# Copy to backend/.env (gitignored). Never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Use the "postgresql+psycopg://" scheme and URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Used by Alembic and the tests: the "Session pooler" string (port 5432, IPv4 compatible).
# Tests create a throwaway schema named test_<random> and drop it afterwards; they refuse to run otherwise.
DATABASE_URL_MIGRATIONS=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Comma-separated explicit allowlist. A wildcard is rejected at startup.
CORS_ORIGINS=http://localhost:5173
